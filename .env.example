# Gmail account used only by the server-side Digital Card submission route.
GMAIL_USER=nextprintny@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password

# Server-side only. Never prefix these with NEXT_PUBLIC_ or expose them in client code.
OPENAI_API_KEY=your_openai_api_key
