# Gmail account used only by the server-side Digital Card submission route.
GMAIL_USER=nextprintny@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password

# Server-side only. Never prefix these with NEXT_PUBLIC_ or expose them in client code.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_openai_model
OPENAI_IMAGE_MODEL=your_openai_image_model

# AI Content System PayPal credentials are server-side only and isolated from other products.
AI_CONTENT_PAYPAL_CLIENT_ID=your_ai_content_paypal_client_id
AI_CONTENT_PAYPAL_CLIENT_SECRET=your_ai_content_paypal_client_secret
AI_CONTENT_PAYPAL_ENV=sandbox
